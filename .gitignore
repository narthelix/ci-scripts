__pycache__/
*.pyc

# Secrets never enter git. `.env.*` covers .env.local / .env.production etc;
# the negation keeps the committed template. Added org-wide 2026-09-09 after a
# committed `.env` was found in narthelix/local-env history
# (narthelix/muznara#1361) -- `secret-scan` is the gate, this is the second
# layer that stops the file being staged in the first place.
.env
.env.*
!.env.example

# macOS Finder artefakti. Global ~/.gitignore_global da var ama o MAKINEYE
# bagli ve repoyla seyahat etmiyor; bu satir her katkiciyi kapsar.
.DS_Store
